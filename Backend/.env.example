# Google Gemini API Keys
# Add one or more keys for automatic quota rotation.
# If one key hits its daily limit, the system automatically tries the next key.

GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here   # optional backup
GEMINI_API_KEY_3=your_gemini_api_key_3_here   # optional backup

# You can also use a single key (used if numbered keys are not set):
# GEMINI_API_KEY=your_single_key_here
